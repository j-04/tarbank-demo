# Copy this file to .env and replace every placeholder with a local secret.
TARBANK_DATABASE_NAME=tarbank
TARBANK_DATABASE_USERNAME=tarbank
TARBANK_DATABASE_PASSWORD=replace-with-a-local-database-password
TARBANK_DATABASE_URL=jdbc:postgresql://postgres:5432/tarbank
TARBANK_REDIS_HOST=redis
TARBANK_REDIS_PORT=6379
TARBANK_REDIS_PASSWORD=replace-with-a-local-redis-password
TARBANK_JWT_SIGNING_KEY=replace-with-at-least-32-characters
TARBANK_DOCUMENT_ENCRYPTION_KEY=replace-with-at-least-32-characters
TARBANK_DOCUMENT_LOOKUP_HMAC_KEY=replace-with-at-least-32-characters
TARBANK_IDEMPOTENCY_FINGERPRINT_HMAC_KEY=replace-with-a-distinct-at-least-32-character-secret
TARBANK_MANAGER_USERNAME=manager
TARBANK_MANAGER_PASSWORD=replace-with-an-exactly-12-character-password
TARBANK_MANAGER_FIRST_NAME=Demo
TARBANK_MANAGER_LAST_NAME=Manager
